# --- Local, unpublished material ---------------------------------------------
# curriculum/ holds the design specification the code cites as docs/NN.
/curriculum/
/portfolio_briefing/
# PDFs (printed study notes) stay local, wherever they are saved.
*.pdf

# --- Python / tooling ---------------------------------------------------------
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
build/
dist/

# --- Data, runs and model artefacts (multi-GB; regenerated by `make demo`) -----
# Root-anchored on purpose: the package sub-module src/floodfusion/data/ MUST stay
# tracked (see the warning in src/floodfusion/data/__init__.py).
/data/
/runs/
/chips/
*.pt
*.ckpt
*.safetensors
*.npz
# Logits of the v1.1 checkpoints on seeded noise (no data, no weights): pins them across refactors.
!/tests/fixtures/golden_v11.npz
# Rasters and tables are data, never source (Sen1Floods11 declares no licence).
*.tif
*.tiff
*.parquet
*.gpkg

# --- Secrets never belong here -------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
credentials*.json
service-account*.json
.secrets/

# Large figures produced by evaluation are regenerated; the Markdown reports
# under reports/ are committed as the reproducibility record (P1-M4, P1-M5).
/reports/figures/
# The v1.1 re-run of the synthetic figures (unreferenced; assets/ keeps v1.0's, within 0.017 IoU).
/assets/v11/
/reports/products/
# The explainer site is built from site/ and reports/ by scripts/build_site.py.
/_site/

# --- Editors / OS ------------------------------------------------------------
.idea/
.vscode/
*.swp
.DS_Store
/reports/products/
